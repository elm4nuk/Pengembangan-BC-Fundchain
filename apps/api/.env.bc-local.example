# Salin menjadi .env.bc-local. File hasil salinan diabaikan Git.
FUNDCHAIN_ENV=bc-local

# Server
PORT=3000
WEB_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL dari compose.bc-local.yml. Kedua URL wajib menunjuk target ini.
DATABASE_URL="postgresql://fundchain:fundchain_bc_local@127.0.0.1:5433/fundchain_bc_dev?schema=public"
DIRECT_URL="postgresql://fundchain:fundchain_bc_local@127.0.0.1:5433/fundchain_bc_dev?schema=public"

# Demo lokal dan pembayaran mock
DEMO_MODE=true
ENABLE_DEV_TOOLS=true
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=bc-local-mock-webhook-secret
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com

# Hardhat localhost. Private key ini adalah akun latihan #1 bawaan Hardhat.
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BLOCKCHAIN_CONFIRMATIONS=1

# Start aman: aktifkan hanya lewat `pnpm bc-local:api:worker` setelah preflight lolos.
WORKER_ENABLED=false
WORKER_MODE=interval
WORKER_POLL_MS=1000
CRON_SECRET=
