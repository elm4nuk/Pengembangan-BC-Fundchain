# Hanya untuk deploy ke Sepolia. Local (hardhat node) tidak butuh file ini.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Wallet admin (cold) yang men-deploy & memegang DEFAULT_ADMIN_ROLE
DEPLOYER_PRIVATE_KEY=
# Alamat wallet relayer backend (HARUS beda dari admin)
RELAYER_ADDRESS=
ETHERSCAN_API_KEY=
# Monitoring saldo relayer (scripts/relayer.ts)
RELAYER_MIN_BALANCE_ETH=0.02
# Discord webhook untuk alert (kosong = alert hanya di console)
ALERT_WEBHOOK_URL=